[Unit]
Description=Proctoring UDS API (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proctoring
Group=proctoring
WorkingDirectory=/opt/proctoring/releases/%i
EnvironmentFile=/etc/proctoring/api-%i.env
ExecStart=/usr/bin/pnpm --filter @proctoring/api start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

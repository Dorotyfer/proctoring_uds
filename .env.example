PROCTORING_HOST=127.0.0.1
PROCTORING_PORT=3001
DATABASE_URL=mysql://proctoring:change-this@database-host:3306/proctoring
MOODLE_INTEGRATION_KEY=change-this-with-a-long-random-secret
JWT_SECRET=change-this-with-a-different-long-random-secret
EVIDENCE_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
BIOMETRIC_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
SFACE_COSINE_THRESHOLD=0.593
LIVENESS_CENTER_THRESHOLD=0.15
LIVENESS_TURN_THRESHOLD=0.30
SFACE_INTERVAL_SECONDS=60
MODEL_MANIFEST_PATH=/etc/proctoring/model-weights.json
INFERENCE_REQUESTED=false
WEB_ORIGIN=https://proctoring.example.edu
API_PUBLIC_URL=https://api.proctoring.example.edu
PANEL_URL=https://proctoring.example.edu
PANEL_SSO_SECRET=replace-with-at-least-32-characters
EVIDENCE_RETENTION_DAYS=30
S3_ENDPOINT=https://s3.example.edu
S3_REGION=us-east-1
S3_BUCKET=proctoring-evidence
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
# Mantenga AES256 en producción. Use none únicamente con MinIO local sin KMS.
S3_SERVER_SIDE_ENCRYPTION=AES256

# Variables exclusivas de la prueba de carga; no son necesarias para iniciar la API.
PILOT_API_URL=https://api.proctoring.example.edu
PILOT_SESSIONS=1000
PILOT_CONCURRENCY=50
PILOT_MAX_RETRIES=2
PILOT_SEED=acceptance-01

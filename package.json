{
  "name": "proctoring-uds",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.6.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up --detach --wait --wait-timeout 60",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:check": "node --env-file=.env scripts/check-infra.mjs"
  },
  "devDependencies": {
    "pg": "^8.16.3",
    "redis": "^5.8.1"
  }
}

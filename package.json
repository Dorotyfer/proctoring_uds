{
  "name": "proctoring-uds",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.6.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "infra:check": "node --env-file=.env scripts/check-infra.mjs",
    "db:migrate:sessions": "node --env-file=.env scripts/apply-migration.mjs apps/api/src/db/migrations/001_sessions.sql",
    "db:migrate:preparation": "node --env-file=.env scripts/apply-migration.mjs apps/api/src/db/migrations/002_preparation_submissions.sql && node --env-file=.env scripts/apply-migration.mjs apps/api/src/db/migrations/003_preparation_liveness.sql",
    "test:infra": "node --test scripts/check-infra.test.mjs scripts/mysql-config.test.mjs scripts/apply-migration.test.mjs",
    "test": "pnpm --filter @proctoring/contracts test && pnpm --filter @proctoring/api test && pnpm test:infra"
  },
  "devDependencies": {
    "mysql2": "^3.14.4"
  }
}
